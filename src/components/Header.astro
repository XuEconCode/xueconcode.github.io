---
import ThemeToggle from './ThemeToggle.astro';
import { getProfile } from '../lib/content';
import { useTranslations, type Lang } from '../i18n/ui';
import { htmlLang, localizePath, otherLang, stripLang, tx } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** 语言切换链接：另一语言的对应页面（没有时为其列表页或首页） */
  alternateHref: string;
}

const { lang, alternateHref } = Astro.props;
const t = useTranslations(lang);
const profile = await getProfile();
const alt = otherLang(lang);
const section = stripLang(Astro.url.pathname).split('/')[1] ?? '';
const nav = (['research', 'projects', 'writing', 'cv'] as const).map((key) => ({
  key,
  href: localizePath(`/${key}/`, lang),
  current: section === key,
}));
---

<header class="site-header">
  <div class="shell">
    <div class="header-inner">
      <a class="brand" href={localizePath('/', lang)}>{tx(profile.name, lang)}</a>
      <nav class="site-nav" aria-label={t('nav.label')}>
        {
          nav.map((item) => (
            <a href={item.href} aria-current={item.current ? 'page' : undefined}>
              {t(`nav.${item.key}`)}
            </a>
          ))
        }
      </nav>
      <div class="header-tools">
        <a class:list={['lang-switch', alt]} href={alternateHref} hreflang={htmlLang[alt]} lang={htmlLang[alt]}>
          {alt === 'en' ? 'English' : '中文'}
        </a>
        <ThemeToggle label={t('theme.toggle')} />
      </div>
    </div>
    <div class="double-rule" aria-hidden="true"></div>
  </div>
</header>

<style>
  .site-header {
    padding-top: 4rem;
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-bottom: 1.25rem;
  }

  .brand {
    color: var(--ink);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.24em;
  }

  :global(:root:lang(en)) .brand {
    font-size: 1.1875rem;
    letter-spacing: 0.04em;
  }

  .site-nav {
    display: flex;
    gap: 1.875rem;
    font-size: var(--text-sm);
    letter-spacing: 0.2em;
  }

  :global(:root:lang(en)) .site-nav {
    font-size: 1.0625rem;
    letter-spacing: 0.04em;
  }

  .site-nav a {
    color: var(--text);
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--seal);
  }

  .header-tools {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .lang-switch {
    color: var(--muted);
  }

  .lang-switch.en {
    font-family: var(--font-latin);
    font-size: 1.125rem;
    font-style: italic;
  }

  .lang-switch.zh {
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    letter-spacing: 0.2em;
  }

  @media (max-width: 56rem) {
    .site-header {
      padding-top: 1.75rem;
    }
  }

  @media (max-width: 40rem) {
    .site-nav {
      order: 3;
      justify-content: space-between;
      width: 100%;
      gap: 1rem;
    }
  }
</style>
