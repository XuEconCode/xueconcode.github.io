export type IconName = keyof typeof stroke | keyof typeof fill;

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
}

const { name, size = '1em', class: className } = Astro.props;
const isFill = name in fill;
const body = isFill ? `<path d="${fill[name as keyof typeof fill]}"/>` : stroke[name as keyof typeof stroke];
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={isFill ? 'currentColor' : 'none'}
  stroke={isFill ? 'none' : 'currentColor'}
  stroke-width={isFill ? undefined : 1.75}
  stroke-linecap={isFill ? undefined : 'round'}
  stroke-linejoin={isFill ? undefined : 'round'}
  aria-hidden="true"
  focusable="false"
  set:html={body}
/>

<style>
  .icon {
    display: inline-block;
    flex: none;
    vertical-align: -0.125em;
  }
</style>
