---
/**
 * 履历条目：教育、经历、荣誉、动态。
 * stacked：日期在上（首页两栏）；aside：日期在左（简历页）。
 */
import { inlineMd } from '../lib/inline-md';

export interface TimelineItem {
  when: string;
  title: string;
  subtitle?: string;
  details?: string[];
}

interface Props {
  items: TimelineItem[];
  layout?: 'stacked' | 'aside';
  /** 标题不加粗（用于「动态」） */
  plain?: boolean;
}

const { items, layout = 'stacked', plain = false } = Astro.props;
---

<ol class:list={['timeline', layout, { plain }]}>
  {
    items.map((item) => (
      <li class="tl-item">
        <span class="tl-when latin tabular">{item.when}</span>
        <div class="tl-body">
          <p class="tl-title" set:html={inlineMd(item.title)} />
          {item.subtitle && <p class="tl-sub" set:html={inlineMd(item.subtitle)} />}
          {item.details && item.details.length > 0 && (
            <ul class="tl-details">
              {item.details.map((detail) => (
                <li set:html={inlineMd(detail)} />
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    padding: 0;
    list-style: none;
  }

  .tl-when {
    color: var(--seal);
    font-size: 1.125rem;
    line-height: 1.6;
    white-space: nowrap;
  }

  .tl-title {
    color: var(--ink);
    font-size: 1.09375rem;
    font-weight: 600;
    line-height: 1.7;
  }

  .plain .tl-title {
    color: var(--text);
    font-weight: 400;
  }

  .tl-sub {
    color: var(--muted);
    font-size: 0.96875rem;
    line-height: 1.7;
  }

  .tl-details {
    margin-top: 0.3rem;
    padding-left: 1.2em;
    list-style: disc;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.75;
  }

  .tl-details li::marker {
    color: var(--seal);
  }

  /* 日期在上：条目之间用虚线分隔 */
  .stacked .tl-item + .tl-item {
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px dashed var(--line);
  }

  .stacked .tl-body {
    margin-top: 0.3rem;
  }

  /* 日期在左 */
  .aside .tl-item {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0 1.5rem;
  }

  .aside .tl-item + .tl-item {
    margin-top: 1rem;
  }

  @media (max-width: 40rem) {
    .aside .tl-item {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    .tl-item {
      break-inside: avoid;
    }

    .aside .tl-item {
      grid-template-columns: 11rem minmax(0, 1fr);
    }

    .aside .tl-item + .tl-item,
    .stacked .tl-item + .tl-item {
      margin-top: 0.4rem;
      padding-top: 0;
      border-top: 0;
    }
  }
</style>
